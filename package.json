{
  "name": "sr2d4-lst-explorer",
  "version": "1.0.0",
  "description": "Independent web GIS explorer for SR2D4 imagery and Land Surface Temperature",
  "type": "module",
  "main": "./dist/index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "keywords": [
    "SR2D4",
    "LST",
    "remote-sensing",
    "GIS",
    "GeoTIFF",
    "MapLibre"
  ],
  "author": "Leandro Gregorio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LeandroGregorio7/lst-super-resolution.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.2",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "maplibre-gl": "^5.24.0",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "geotiff": "^3.0.5",
    "proj4": "^2.22.0"
  }
}
